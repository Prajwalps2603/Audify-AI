# TeleCaller AI — Environment Variables & API Keys Template (Phase 16)
# Copy this file to .env or inject into your CI/CD build pipelines.
# NEVER commit your production secrets or service keys to git.

# ─────────────────────────────────────────────────────────────
# 1. GOOGLE CLOUD OAUTH & DRIVE / SHEETS APIS
# ─────────────────────────────────────────────────────────────
# Web Client ID from Google Cloud Console → APIs & Services → Credentials
# (Safe to include in app package, used for Google Sign-In authentication)
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Target Google Drive Root Folder ID for call recording backups (optional, defaults to "TeleCaller AI Recordings")
GOOGLE_DRIVE_FOLDER_ID=

# Target Google Sheets Spreadsheet ID for customer CRM rows (optional, defaults to auto-created sheet)
GOOGLE_SHEETS_SPREADSHEET_ID=

# ─────────────────────────────────────────────────────────────
# 2. SPEECH-TO-TEXT (STT) TRANSCRIPTION PROVIDERS
# ─────────────────────────────────────────────────────────────
# Default active provider: GOOGLE | OPENAI | DEEPGRAM | ASSEMBLYAI
DEFAULT_STT_PROVIDER=GOOGLE

# Google Cloud Speech-to-Text v2 API Key
GOOGLE_SPEECH_API_KEY=

# OpenAI Whisper API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Deepgram Speech API Key (https://console.deepgram.com/)
DEEPGRAM_API_KEY=

# AssemblyAI Speech API Key (https://www.assemblyai.com/)
ASSEMBLYAI_API_KEY=

# ─────────────────────────────────────────────────────────────
# 3. BACKEND & WEBSOCKET CONFIGURATION (OPTIONAL)
# ─────────────────────────────────────────────────────────────
# Node.js Companion Backend URL (for offline worker queue or web dashboard)
BACKEND_API_URL=https://api.telecaller.ai
