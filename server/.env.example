# Audify AI — Server Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to source control.

# ─── Google OAuth ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Update this to your HTTPS domain when deploying to production
GOOGLE_REDIRECT_URI=https://api.yourdomain.com/api/auth/callback

# ─── Google Drive API ────────────────────────────────────────────
GOOGLE_DRIVE_FOLDER_NAME=Audify AI

# ─── Google Sheets API ───────────────────────────────────────────
GOOGLE_SHEETS_SHEET_NAME=Audify AI - Call Records

# ─── Speech-to-Text Provider ─────────────────────────────────────
# Supported values: GOOGLE | OPENAI | DEEPGRAM | ASSEMBLYAI
SPEECH_TO_TEXT_PROVIDER=GOOGLE
SPEECH_TO_TEXT_API_KEY=

# ─── Backend & HTTPS Configuration ───────────────────────────────
NODE_ENV=development

# HTTP port (used for Let's Encrypt ACME challenge in production, and HTTP→HTTPS redirect)
# Must be port 80 in production (Let's Encrypt requirement)
HTTP_PORT=80

# HTTPS port (use 443 in production, 3443 in development to avoid needing root)
HTTPS_PORT=3443

# Your public domain (e.g. api.audifyai.com). Leave blank for development (self-signed cert).
DOMAIN=

# Contact email for Let's Encrypt certificate notifications
MAINTAINER_EMAIL=

# Set to false when you are ready for REAL certificates (removes LE staging mode)
# Leave as true during testing to avoid hitting Let's Encrypt rate limits
LETS_ENCRYPT_STAGING=true

# Directory where Greenlock stores certificates (defaults to .greenlock/)
GREENLOCK_CONFIG_DIR=.greenlock

BACKEND_URL=https://localhost:3443

# ─── Security ────────────────────────────────────────────────────
JWT_SECRET=
SESSION_SECRET=
ADMIN_SECRET_KEY=

# ─── Database (if needed in future phases) ──────────────────────
DATABASE_URL=
