# TeleCaller AI — Server Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to source control.

# ─── Google OAuth ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# ─── Google Drive API ────────────────────────────────────────────
GOOGLE_DRIVE_FOLDER_NAME=TeleCaller AI

# ─── Google Sheets API ───────────────────────────────────────────
GOOGLE_SHEETS_SHEET_NAME=TeleCaller AI - Call Records

# ─── Speech-to-Text Provider ─────────────────────────────────────
# Supported values: GOOGLE | OPENAI | DEEPGRAM
SPEECH_TO_TEXT_PROVIDER=GOOGLE
SPEECH_TO_TEXT_API_KEY=

# ─── Backend Configuration ───────────────────────────────────────
PORT=3000
NODE_ENV=development
BACKEND_URL=http://localhost:3000

# ─── Security ────────────────────────────────────────────────────
JWT_SECRET=
SESSION_SECRET=

# ─── Database (if needed in Phase 12+) ──────────────────────────
DATABASE_URL=
